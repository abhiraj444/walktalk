# WalkTalk Signaling & Bridge Server Configuration

PORT=8080
FAMILY_ID=demo_family

# Firebase Admin SDK Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://walktalk-intercom-default-rtdb.firebaseio.com

# Cloudflare Realtime TURN (Optional - falls back to Google public STUN)
# Obtain from Cloudflare Dashboard -> Calls / Realtime -> TURN Keys
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Cloudflare Quick Tunnel Configuration
ENABLE_QUICK_TUNNEL=true
CLOUDFLARED_PATH=cloudflared
